# VocaFlow Backend Environment Variables Configuration Template

# Database Connection Settings
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>?schema=public"
DIRECT_URL="postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>?schema=public"

# Authentication Cryptographic Tokens (Generate secure random base64 values)
JWT_SECRET=your_jwt_secret_token_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_token_here

# Network Server Port and URL configurations
PORT=3001
SERVER_URL=https://<your_subdomain>.ngrok-free.dev
FRONTEND_URL=http://localhost:5173

# Redis In-Memory Key Value Queue Storage URL
REDIS_URL="redis://127.0.0.1:6379"

# Human Agent Backup phone number (E.164 standard formatting)
HUMAN_AGENT_NUMBER=+1XXXXXXXXXX

# Google Calendar OAuth (for Receptionist/Booking agent appointments integration)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Speech-to-Text low-latency streaming pipeline (Deepgram API)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
USE_DEEPGRAM_STREAMING=true

# Text-to-Speech high quality voice synthesis (ElevenLabs API)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Twilio Inbound & Outbound Calling credentials
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# OpenAI Conversational LLM Engine API Key
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
